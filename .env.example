# Neon Postgres (pooled connection string for the app runtime)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/careproof?sslmode=require"
# Unpooled string, used for `prisma db push` / migrations (DDL is blocked through the pooler)
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST/careproof?sslmode=require"
# Dedicated throwaway databases for the test suite
DATABASE_URL_TEST="postgresql://USER:PASSWORD@HOST/careproof_test?sslmode=require"
DATABASE_URL_TEST_UNPOOLED="postgresql://USER:PASSWORD@HOST/careproof_test?sslmode=require"
# Long random string; pepper for password hashing. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_PEPPER="generate-a-long-random-hex-string"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
